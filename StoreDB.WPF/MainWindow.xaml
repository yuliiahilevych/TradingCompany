<Window x:Class="StoreDB.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:StoreViewModels.Main;assembly=StoreViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="TradingCompany" Height="460" Width="720"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <Menu.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="False" />
                </ItemsPanelTemplate>
            </Menu.ItemsPanel>

            <MenuItem Header="_Менеджер товарів" Command="{Binding OpenManagerCommand}" FontWeight="SemiBold" />

            <MenuItem DockPanel.Dock="Right" Command="{Binding LogoutCommand}">
                <MenuItem.Header>
                    <TextBlock>
                        <Run Text="{Binding UserName, Mode=OneWay}" Foreground="Gray" />
                        <Run Text="  ·  Вийти" />
                    </TextBlock>
                </MenuItem.Header>
            </MenuItem>
        </Menu>

        <Grid Background="#F1F5F9">
            <Border Background="White" CornerRadius="10" Padding="32,28"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    MaxWidth="520" Margin="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Ласкаво просимо до TradingCompany" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="Система керування товарами" Foreground="Gray" Margin="0,4,0,0" />

                    <Separator Margin="0,18" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Користувач:" Foreground="Gray" Margin="0,0,12,6" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding UserName}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Роль:" Foreground="Gray" Margin="0,0,12,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RoleName}" FontWeight="SemiBold" />
                    </Grid>

                    <Border CornerRadius="6" Padding="12,8" Margin="0,18,0,0"
                            Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProductManager}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding AccessMessage}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>