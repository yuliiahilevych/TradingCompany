<Window x:Class="StoreDB.WPF.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:StoreViewModels.Products;assembly=StoreViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ProductsViewModel}"
        Title="Товари" Height="560" Width="1050"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <DataTemplate x:Key="ProductStatusTemplate">
            <Border x:Name="badge" CornerRadius="3" Padding="6,1" HorizontalAlignment="Left" Background="#E3F4E5">
                <TextBlock x:Name="text" Text="активний" Foreground="DarkGreen" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                    <Setter TargetName="badge" Property="Background" Value="#FBE3E3" />
                    <Setter TargetName="text" Property="Text" Value="заблоковано" />
                    <Setter TargetName="text" Property="Foreground" Value="Firebrick" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="F5" Command="{Binding LoadCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Товар">
                <MenuItem Header="_Додати" Command="{Binding AddCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="_Зберегти" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="_Оновити" Command="{Binding LoadCommand}" InputGestureText="F5" />
                <Separator />
                <MenuItem Header="З_акрити" Click="MenuClose_Click" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding Products.Count, StringFormat=Товарів: {0}}" />
            <Separator />
            <TextBlock Text="{Binding StatusMessage}" />
        </StatusBar>

        <Border DockPanel.Dock="Top" Style="{StaticResource SuccessBanner}" Tag="{Binding StatusMessage}">
            <TextBlock Foreground="DarkGreen" TextWrapping="Wrap">
                <Run Text="✔" FontWeight="Bold" />
                <Run Text="{Binding StatusMessage, Mode=OneWay}" />
            </TextBlock>
        </Border>
        <Border DockPanel.Dock="Top" Style="{StaticResource ErrorBanner}" Tag="{Binding ErrorMessage}">
            <TextBlock Foreground="Firebrick" TextWrapping="Wrap">
                <Run Text="✖" FontWeight="Bold" />
                <Run Text="{Binding ErrorMessage, Mode=OneWay}" />
            </TextBlock>
        </Border>
        
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,10,10,0">
            <TextBlock Text="Пошук:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Width="220" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Категорія:" VerticalAlignment="Center" Margin="20,0,6,0" />
            <ComboBox Width="200"
                      ItemsSource="{Binding FilterCategories}"
                      DisplayMemberPath="CategoryName" SelectedValuePath="CategoryId"
                      SelectedValue="{Binding FilterCategoryId}" />
        </StackPanel>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="400" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button Content="Додати" Command="{Binding AddCommand}" Padding="10,3" Margin="0,0,6,6" />
                    <Button Style="{StaticResource DangerButton}" Content="Заблокувати" Command="{Binding BlockCommand}" Padding="10,3" Margin="0,0,6,6" />                  
                    <Button Content="Розблокувати" Command="{Binding UnblockCommand}" Padding="10,3" Margin="0,0,6,6" />
                    <Button Content="Історія цін" Command="{Binding ShowHistoryCommand}" Padding="10,3" Margin="0,0,6,6" />
                    <Button Style="{StaticResource DangerButton}" Content="Видалити" Command="{Binding DeleteCommand}" Padding="10,3" Margin="0,0,6,6" />
                </WrapPanel>

                <DataGrid ItemsSource="{Binding Products}"
                          SelectedItem="{Binding SelectedProduct}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding ProductId}" />
                        <DataGridTextColumn Header="Назва" Binding="{Binding ProductName}" Width="2*" />
                        <DataGridTextColumn Header="Категорія" Binding="{Binding CategoryName}" Width="*" />
                        <DataGridTextColumn Header="Вхідна ціна" Binding="{Binding PurchasePrice, StringFormat=N2}" />
                        <DataGridTextColumn Header="Ціна продажу" Binding="{Binding SellingPrice, StringFormat=N2}" />
                        <DataGridTemplateColumn Header="Статус" SortMemberPath="IsBlocked"
                                                CellTemplate="{StaticResource ProductStatusTemplate}" />
                        <DataGridTextColumn Header="Оновлено" Binding="{Binding RowUpdateTime, StringFormat=dd.MM.yyyy HH:mm}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Margin="6,0" />

            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Зберегти" Command="{Binding SaveCommand}" Padding="12,3" Margin="0,0,6,0" />                        <Button Content="Скасувати" Command="{Binding CancelCommand}" Padding="12,3" />
                    </StackPanel>
                </StackPanel>

                <GroupBox Header="{Binding Editor.Header, FallbackValue=Товар}" IsEnabled="{Binding IsEditing}">
                    <StackPanel DataContext="{Binding Editor}" Margin="6">
                        <Label Content="_Категорія:" Target="{Binding ElementName=cmbCategory}" Padding="0,0,0,3" />
                        <ComboBox x:Name="cmbCategory" Margin="0,0,14,0"
                                  ItemsSource="{Binding DataContext.ActiveCategories, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="CategoryName" SelectedValuePath="CategoryId"
                                  SelectedValue="{Binding CategoryId}" />

                        <Label Content="_Назва:" Target="{Binding ElementName=txtName}" Padding="0,10,0,3" />
                        <TextBox x:Name="txtName" Margin="0,0,14,0"
                                 Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}" />

                        <Label Content="_Вхідна ціна:" Target="{Binding ElementName=txtPurchase}" Padding="0,10,0,3" />
                        <TextBox x:Name="txtPurchase" Margin="0,0,14,0"
                                 Text="{Binding PurchasePriceText, UpdateSourceTrigger=PropertyChanged}" />

                        <Label Content="Ціна _продажу:" Target="{Binding ElementName=txtSelling}" Padding="0,10,0,3" />
                        <TextBox x:Name="txtSelling" Margin="0,0,14,0"
                                 Text="{Binding SellingPriceText, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Товар заблоковано" Foreground="Firebrick" Margin="0,10,0,0"
                                   Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </GroupBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>